    "claude-code",
    "pi"
  ],
  "skill_refs": [
    "repo-orient"
  ],
  "prompt": "prompt.md",
  "rubric": "rubric.md",
  "tags": [
    "developer-daily",
    "normal-dev-chat",
    "bug-report",
    "repo-orientation"
  ],
  "inputs": {
